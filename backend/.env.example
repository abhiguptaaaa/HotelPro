NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Connection String:
# For local MongoDB: mongodb://127.0.0.1:27017/hotelpro
# For MongoDB Atlas (Free Cloud): mongodb+srv://<username>:<password>@cluster0.mongodb.net/hotelpro?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/hotelpro

# JWT Authentication Secret
JWT_SECRET=hotelpro_super_secret_jwt_key_2026_placement_ready
JWT_EXPIRE=30d

# Email Service (Nodemailer - Optional / Ethereal test account by default)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=no-reply@hotelpro.com

# Payment Gateway (Mock / Sandbox keys)
STRIPE_SECRET_KEY=sk_test_hotelpro_mock_key
RAZORPAY_KEY_ID=rzp_test_hotelpro_mock_id
RAZORPAY_KEY_SECRET=rzp_test_hotelpro_mock_secret
